name: Hello Workflow

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  hello:
    runs-on: ubuntu-latest
    steps:
      - name: Salomlashish
        run: echo "Salom, GitHub Actions!"

      - name: Muhit haqida malumot
        run: |
          echo "Repozitoriy: $GITHUB_REPOSITORY"
